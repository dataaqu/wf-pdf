NODE_ENV=production
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="https://your-domain.com"

# Puppeteer / Chromium
# Production uses @sparticuz/chromium (self-contained) — no path needed.
# PUPPETEER_EXECUTABLE_PATH is an optional override if you host your own Chrome.
# PUPPETEER_SKIP_DOWNLOAD is set automatically via nixpacks.toml on Railway.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome-stable"
